# Study workers: one unit per worker, six of them on the 2 vCPU / 4 GB host:
#   systemctl enable --now communicat-study@{1..6}
# Copy to /etc/systemd/system/communicat-study@.service. Thesis study, see docs/study.md. Fill the queue with
#   php artisan study:queue --group=ID --order-seed=SEED
# Broadcasting is off for these workers: a study run has no viewer, and a missing
# Reverb would otherwise interrupt every turn.
# The job's turn timeout (config study.run.turn_timeout) only works with ext-pcntl.

[Unit]
Description=Communicat study worker %i
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/communicat
Environment=BROADCAST_CONNECTION=log
# One job is one turn: about 200 turns an hour per worker, so it restarts hourly and leaks nothing.
ExecStart=php artisan queue:work study --queue=study --sleep=5 --max-jobs=200 --max-time=3600
Restart=always
RestartSec=5
# Let a running turn finish on stop: above the turn timeout (360 s), checked by StudyOpsConfigTest.
TimeoutStopSec=400
KillSignal=SIGTERM
# SIGTERM to the worker only: its ParallelPrompts children finish the turn instead of dying mid-call.
# SIGKILL after TimeoutStopSec still reaches the whole group.
KillMode=mixed
# The whole control group counts, ParallelPrompts children included (worker ~120 MB + up to
# four children at 60-100 MB). MemoryHigh throttles before the OOM kill; the probe run checks it.
MemoryHigh=450M
MemoryMax=550M

[Install]
WantedBy=multi-user.target
